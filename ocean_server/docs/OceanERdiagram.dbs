				<comment><![CDATA[Overall order experience rating]]></comment>
			</column>
			<column name="deliveryExperience" type="ENUM" >
				<enumeration><![CDATA['excellent','good','average','poor','terrible']]></enumeration>
				<comment><![CDATA[Delivery experience rating]]></comment>
			</column>
			<column name="productQuality" type="ENUM" >
				<enumeration><![CDATA['excellent','good','average','poor','terrible']]></enumeration>
				<comment><![CDATA[Product quality rating]]></comment>
			</column>
			<column name="customerService" type="ENUM" >
				<enumeration><![CDATA['excellent','good','average','poor','terrible']]></enumeration>
				<comment><![CDATA[Customer service rating]]></comment>
			</column>
			<column name="pricingRating" type="ENUM" >
				<enumeration><![CDATA['excellent','good','average','poor','terrible']]></enumeration>
				<comment><![CDATA[Pricing competitiveness rating]]></comment>
			</column>
			<column name="orderId" type="VARCHAR" length="100" >
				<comment><![CDATA[Reference to the order this review is based on]]></comment>
			</column>
			<column name="orderDate" type="DATETIME" >
				<comment><![CDATA[Date of the order being reviewed]]></comment>
