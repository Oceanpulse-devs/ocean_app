		<table name="group_buy_participants" row_count="0" spec="" >
			<column name="id" type="INT" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="group_buy_id" type="INT" mandatory="y" >
				<comment><![CDATA[ID of the group buy]]></comment>
			</column>
			<column name="user_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[ID of the user joining the group buy]]></comment>
			</column>
			<column name="quantity" type="INT" mandatory="y" >
				<defo><![CDATA['1']]></defo>
				<comment><![CDATA[Quantity of items the user wants to buy]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','reserved','paid','fulfilled','cancelled','disputed']]></enumeration>
				<comment><![CDATA[Overall lifecycle status of the participation]]></comment>
			</column>
			<column name="payment_status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','paid','refunded']]></enumeration>
				<comment><![CDATA[Payment status for this participation]]></comment>
			</column>
			<column name="fulfillment_status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','processing','ready_for_pickup','in_transit','delivered','cancelled']]></enumeration>
				<comment><![CDATA[Fulfillment stage for this participant]]></comment>
			</column>
			<column name="status_note" type="TEXT" >
				<comment><![CDATA[Optional note describing the latest status update]]></comment>
			</column>
			<column name="status_updated_at" type="DATETIME" >
				<comment><![CDATA[Timestamp when status/fulfillment was last updated]]></comment>
			</column>
			<column name="payment_confirmed_at" type="DATETIME" >
				<comment><![CDATA[When payment was confirmed by the seller]]></comment>
			</column>
			<column name="fulfilled_at" type="DATETIME" >
				<comment><![CDATA[When goods were marked fulfilled/delivered]]></comment>
			</column>
			<column name="issue_status" type="ENUM" >
				<defo><![CDATA['none']]></defo>
				<enumeration><![CDATA['none','reported','resolved']]></enumeration>
				<comment><![CDATA[Whether this participant has reported an issue]]></comment>
			</column>
			<column name="issue_note" type="TEXT" >
				<comment><![CDATA[Seller/admin notes regarding disputes/issues]]></comment>
			</column>
			<column name="payment_method" type="VARCHAR" length="100" >
				<comment><![CDATA[Payment method used]]></comment>
			</column>
			<column name="payment_reference" type="VARCHAR" length="255" >
				<comment><![CDATA[Payment reference number]]></comment>
			</column>
			<column name="total_amount" type="DECIMAL" length="10" decimal="2" mandatory="y" >
				<comment><![CDATA[Total amount for this participation (quantity * group_price)]]></comment>
			</column>
			<column name="pickup_location" type="VARCHAR" length="255" >
				<comment><![CDATA[Preferred pickup location for this user]]></comment>
			</column>
			<column name="delivery_address" type="TEXT" >
				<comment><![CDATA[Delivery address if delivery is preferred]]></comment>
			</column>
			<column name="special_requests" type="TEXT" >
				<comment><![CDATA[Any special requests from the user]]></comment>
			</column>
			<column name="joined_at" type="DATETIME" >
				<comment><![CDATA[When the user joined the group buy]]></comment>
			</column>
			<column name="confirmed_at" type="DATETIME" >
				<comment><![CDATA[Deprecated - use status timestamps instead]]></comment>
			</column>
			<column name="cancelled_at" type="DATETIME" >
				<comment><![CDATA[Deprecated - use status timestamps instead]]></comment>
			</column>
			<column name="completed_at" type="DATETIME" >
				<comment><![CDATA[Deprecated - use fulfilled_at instead]]></comment>
			</column>
			<column name="createdAt" type="DATETIME" />
			<column name="updatedAt" type="DATETIME" />
			<index name="pk_group_buy_participants" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="group_buy_participants_group_buy_id_user_id" unique="UNIQUE_KEY" >
				<column name="group_buy_id" />
				<column name="user_id" />
			</index>
			<index name="group_buy_participants_group_buy_id" unique="NORMAL" >
				<column name="group_buy_id" />
			</index>
			<index name="group_buy_participants_user_id" unique="NORMAL" >
				<column name="user_id" />
			</index>
			<index name="group_buy_participants_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="group_buy_participants_payment_status" unique="NORMAL" >
				<column name="payment_status" />
			</index>
			<fk name="group_buy_participants_ibfk_1" to_schema="ocean_app_db" to_table="group_buys" delete_action="cascade" update_action="cascade" options="" >
				<fk_column name="group_buy_id" pk="id" />
			</fk>
			<fk name="group_buy_participants_ibfk_2" to_schema="ocean_app_db" to_table="users" update_action="cascade" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci]]></options>
		</table>
