<project name="MySql" database="MySql" id="74c2c384-1a38-4714-823c-f6311cf3638b" >
	<schema name="ocean_app_db" >
		<table name="advanced_notifications" row_count="0" spec="" >
			<column name="id" type="INT" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="user_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
			</column>
			<column name="notification_type" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['price_drop','group_buy_update','swap_offer','buyer_need_match','auction_ending','new_follower','message_received','product_viewed','search_insight','market_trend','verification_status','subscription_update','system_alert']]></enumeration>
			</column>
			<column name="title" type="VARCHAR" length="255" mandatory="y" />
			<column name="message" type="TEXT" mandatory="y" />
			<column name="priority" type="ENUM" >
				<defo><![CDATA['medium']]></defo>
				<enumeration><![CDATA['low','medium','high','urgent']]></enumeration>
			</column>
			<column name="delivery_methods" type="JSON" mandatory="y" >
				<comment><![CDATA[Array of delivery methods: in_app, push, email, sms]]></comment>
			</column>
			<column name="target_entity_type" type="VARCHAR" length="100" >
				<comment><![CDATA[Type of entity this notification relates to (product, auction, group_buy, etc.)]]></comment>
			</column>
			<column name="target_entity_id" type="VARCHAR" length="255" >
				<comment><![CDATA[ID of the target entity]]></comment>
			</column>
			<column name="metadata" type="JSON" >
				<comment><![CDATA[Additional data for the notification (prices, counts, etc.)]]></comment>
			</column>
			<column name="is_read" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
			</column>
			<column name="is_delivered" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
			</column>
			<column name="delivery_attempts" type="INT" >
				<defo><![CDATA['0']]></defo>
			</column>
			<column name="scheduled_for" type="DATETIME" >
				<comment><![CDATA[When to deliver this notification (for scheduled notifications)]]></comment>
			</column>
			<column name="delivered_at" type="DATETIME" />
			<column name="expires_at" type="DATETIME" >
				<comment><![CDATA[When this notification expires and should be removed]]></comment>
			</column>
			<column name="user_preferences" type="JSON" >
				<comment><![CDATA[User-specific preferences for this notification type]]></comment>
			</column>
			<column name="created_at" type="DATETIME" />
			<column name="updated_at" type="DATETIME" />
			<column name="userId" type="CHAR" length="36" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
			</column>
			<index name="pk_advanced_notifications" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="userId" unique="NORMAL" >
				<column name="userId" />
			</index>
			<index name="advanced_notifications_user_id" unique="NORMAL" >
				<column name="user_id" />
			</index>
			<index name="advanced_notifications_notification_type" unique="NORMAL" >
				<column name="notification_type" />
			</index>
			<index name="advanced_notifications_priority" unique="NORMAL" >
				<column name="priority" />
			</index>
			<index name="advanced_notifications_is_read" unique="NORMAL" >
				<column name="is_read" />
			</index>
			<index name="advanced_notifications_is_delivered" unique="NORMAL" >
				<column name="is_delivered" />
			</index>
			<index name="advanced_notifications_scheduled_for" unique="NORMAL" >
				<column name="scheduled_for" />
			</index>
			<index name="advanced_notifications_expires_at" unique="NORMAL" >
				<column name="expires_at" />
			</index>
			<index name="advanced_notifications_created_at" unique="NORMAL" >
				<column name="created_at" />
			</index>
			<index name="advanced_notifications_target_entity_type_target_entity_id" unique="NORMAL" >
				<column name="target_entity_type" />
				<column name="target_entity_id" />
			</index>
			<fk name="advanced_notifications_ibfk_1" to_schema="ocean_app_db" to_table="users" options="" >
				<fk_column name="user_id" pk="id" />
			</fk>
			<fk name="advanced_notifications_ibfk_2" to_schema="ocean_app_db" to_table="users" delete_action="setNull" update_action="cascade" options="" >
				<fk_column name="userId" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci]]></options>
