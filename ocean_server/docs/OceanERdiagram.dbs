				<comment><![CDATA[Type of user behavior being tracked]]></comment>
			</column>
			<column name="action" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Specific action performed]]></comment>
			</column>
			<column name="target_id" type="VARCHAR" length="255" >
				<comment><![CDATA[ID of the target object (product, post, etc.)]]></comment>
