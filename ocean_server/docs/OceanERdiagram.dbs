				<comment><![CDATA[ID of the item being boosted (UUID as CHAR)]]></comment>
			</column>
			<column name="boost_duration_hours" type="INT" >
				<defo><![CDATA['24']]></defo>
				<comment><![CDATA[Duration in hours]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['active']]></defo>
				<enumeration><![CDATA['active','expired','cancelled']]></enumeration>
			</column>
