		<table name="distributor_inquiries" row_count="0" spec="" >
			<column name="id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
			</column>
			<column name="inquirerId" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Reference to the user making the inquiry]]></comment>
			</column>
			<column name="distributorId" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Reference to the heavy distributor being inquired about]]></comment>
			</column>
			<column name="inquiryType" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['product_inquiry','pricing_inquiry','bulk_order','partnership','general','custom']]></enumeration>
				<comment><![CDATA[Type of inquiry being made]]></comment>
			</column>
			<column name="customInquiryType" type="VARCHAR" length="100" >
				<comment><![CDATA[Custom inquiry type if not covered by predefined types]]></comment>
			</column>
			<column name="subject" type="VARCHAR" length="200" mandatory="y" >
				<comment><![CDATA[Subject/title of the inquiry]]></comment>
			</column>
			<column name="message" type="TEXT" mandatory="y" >
				<comment><![CDATA[Detailed inquiry message]]></comment>
			</column>
			<column name="productCategories" type="JSON" >
				<comment><![CDATA[Product categories the inquirer is interested in]]></comment>
			</column>
			<column name="productBrands" type="JSON" >
				<comment><![CDATA[Specific product brands the inquirer is looking for]]></comment>
			</column>
			<column name="quantityNeeded" type="INT" >
				<comment><![CDATA[Quantity of products needed]]></comment>
			</column>
			<column name="budgetRange" type="ENUM" >
				<enumeration><![CDATA['under_10k','10k_50k','50k_100k','100k_500k','500k_1m','over_1m']]></enumeration>
				<comment><![CDATA[Budget range for the inquiry]]></comment>
			</column>
			<column name="urgencyLevel" type="ENUM" >
				<defo><![CDATA['medium']]></defo>
				<enumeration><![CDATA['low','medium','high','urgent']]></enumeration>
				<comment><![CDATA[Urgency level of the inquiry]]></comment>
			</column>
			<column name="preferredContactMethod" type="ENUM" >
				<defo><![CDATA['any']]></defo>
				<enumeration><![CDATA['email','phone','whatsapp','in_person','any']]></enumeration>
				<comment><![CDATA[Preferred method of contact]]></comment>
			</column>
			<column name="preferredContactTime" type="JSON" >
				<comment><![CDATA[Preferred contact time and days]]></comment>
			</column>
			<column name="location" type="VARCHAR" length="200" >
				<comment><![CDATA[Location where the inquirer is based]]></comment>
			</column>
			<column name="deliveryRequirements" type="TEXT" >
				<comment><![CDATA[Specific delivery requirements or preferences]]></comment>
			</column>
			<column name="additionalFiles" type="JSON" >
				<comment><![CDATA[Array of file attachments (quotes, specifications, etc.)]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','in_progress','responded','closed','cancelled']]></enumeration>
				<comment><![CDATA[Current status of the inquiry]]></comment>
			</column>
			<column name="priority" type="ENUM" >
				<defo><![CDATA['normal']]></defo>
				<enumeration><![CDATA['low','normal','high','urgent']]></enumeration>
				<comment><![CDATA[Priority level assigned to the inquiry]]></comment>
			</column>
			<column name="assignedTo" type="CHAR" length="36" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Staff member assigned to handle this inquiry]]></comment>
			</column>
			<column name="responseDeadline" type="DATETIME" >
				<comment><![CDATA[Deadline for responding to the inquiry]]></comment>
			</column>
			<column name="lastResponseDate" type="DATETIME" >
				<comment><![CDATA[Date of the last response]]></comment>
			</column>
			<column name="responseCount" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of responses to this inquiry]]></comment>
			</column>
			<column name="isRead" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether the inquiry has been read by the distributor]]></comment>
			</column>
			<column name="isArchived" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether the inquiry has been archived]]></comment>
			</column>
			<column name="tags" type="JSON" >
				<comment><![CDATA[Tags for categorizing and organizing inquiries]]></comment>
			</column>
			<column name="notes" type="TEXT" >
				<comment><![CDATA[Internal notes about the inquiry]]></comment>
			</column>
			<column name="createdAt" type="DATETIME" mandatory="y" />
			<column name="updatedAt" type="DATETIME" mandatory="y" />
			<index name="pk_distributor_inquiries" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="distributor_inquiries_inquirer_id" unique="NORMAL" >
