		<table name="market_analytics" row_count="0" spec="" >
			<column name="id" type="INT" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="metric_type" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['product_views','search_queries','category_trends','price_analysis','user_engagement','market_volume','conversion_rates','geographic_distribution']]></enumeration>
				<comment><![CDATA[Type of market metric being tracked]]></comment>
			</column>
			<column name="metric_name" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Specific name of the metric]]></comment>
			</column>
			<column name="metric_value" type="DECIMAL" length="15" decimal="4" mandatory="y" >
				<comment><![CDATA[Numeric value of the metric]]></comment>
			</column>
			<column name="metric_unit" type="VARCHAR" length="50" >
				<comment><![CDATA[Unit of measurement for the metric]]></comment>
			</column>
			<column name="category_id" type="CHAR" length="36" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Product category this metric relates to (if applicable)]]></comment>
			</column>
			<column name="location" type="VARCHAR" length="255" >
				<comment><![CDATA[Geographic location this metric relates to (if applicable)]]></comment>
			</column>
			<column name="time_period" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['hourly','daily','weekly','monthly','quarterly','yearly']]></enumeration>
				<comment><![CDATA[Time period for the metric aggregation]]></comment>
			</column>
			<column name="period_start" type="DATETIME" mandatory="y" >
				<comment><![CDATA[Start of the time period]]></comment>
			</column>
			<column name="period_end" type="DATETIME" mandatory="y" >
				<comment><![CDATA[End of the time period]]></comment>
			</column>
			<column name="comparison_value" type="DECIMAL" length="15" decimal="4" >
				<comment><![CDATA[Previous period value for comparison]]></comment>
			</column>
			<column name="change_percentage" type="DECIMAL" length="5" decimal="2" >
				<comment><![CDATA[Percentage change from previous period]]></comment>
			</column>
			<column name="trend_direction" type="ENUM" >
				<enumeration><![CDATA['increasing','decreasing','stable','fluctuating']]></enumeration>
				<comment><![CDATA[Overall trend direction]]></comment>
			</column>
			<column name="confidence_level" type="DECIMAL" length="3" decimal="2" >
				<comment><![CDATA[Confidence level in the metric (0.00 to 1.00)]]></comment>
			</column>
			<column name="metadata" type="JSON" >
				<comment><![CDATA[Additional metadata and context for the metric]]></comment>
			</column>
			<column name="is_forecast" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this is a forecasted/predicted value]]></comment>
			</column>
			<column name="forecast_accuracy" type="DECIMAL" length="3" decimal="2" >
				<comment><![CDATA[Accuracy of previous forecasts (0.00 to 1.00)]]></comment>
			</column>
			<column name="created_at" type="DATETIME" />
			<column name="updated_at" type="DATETIME" />
