			</column>
			<column name="rating" type="INT" mandatory="y" >
				<comment><![CDATA[Rating from 1 to 5 stars]]></comment>
			</column>
			<column name="title" type="VARCHAR" length="200" >
				<comment><![CDATA[Review title/summary]]></comment>
			</column>
			<column name="reviewText" type="TEXT" mandatory="y" >
				<comment><![CDATA[Detailed review content]]></comment>
			</column>
			<column name="orderExperience" type="ENUM" >
