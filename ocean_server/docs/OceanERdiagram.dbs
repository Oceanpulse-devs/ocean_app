		<table name="group_buys" row_count="0" spec="" >
			<column name="id" type="INT" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="title" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Title of the group buy]]></comment>
			</column>
			<column name="description" type="TEXT" mandatory="y" >
				<comment><![CDATA[Detailed description of the group buy]]></comment>
			</column>
			<column name="category" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Category name for the group buy (e.g., "Fashion", "Electronics")]]></comment>
			</column>
			<column name="subcategory" type="VARCHAR" length="255" >
				<comment><![CDATA[Subcategory for the group buy product]]></comment>
			</column>
			<column name="product_name" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Name of the product being purchased]]></comment>
			</column>
			<column name="product_image" type="JSON" >
				<comment><![CDATA[Array of product image URLs]]></comment>
			</column>
			<column name="ar_model" type="VARCHAR" length="500" >
				<comment><![CDATA[URL to GLB file for AR model viewing]]></comment>
			</column>
			<column name="original_price" type="DECIMAL" length="10" decimal="2" mandatory="y" >
				<comment><![CDATA[Original retail price of the product]]></comment>
			</column>
			<column name="group_price" type="DECIMAL" length="10" decimal="2" mandatory="y" >
				<comment><![CDATA[Discounted price when group buy threshold is met]]></comment>
			</column>
			<column name="min_buyers" type="INT" mandatory="y" >
				<defo><![CDATA['2']]></defo>
				<comment><![CDATA[Minimum number of buyers required to activate group buy]]></comment>
			</column>
			<column name="max_buyers" type="INT" >
				<comment><![CDATA[Maximum number of buyers allowed (optional)]]></comment>
			</column>
			<column name="quantity_unit" type="INT" >
				<comment><![CDATA[Total quantity of units available from seller]]></comment>
			</column>
			<column name="remaining_units" type="INT" >
				<comment><![CDATA[Remaining quantity of units available (computed dynamically)]]></comment>
			</column>
			<column name="current_buyers" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Current number of committed buyers]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','active','successful','failed','cancelled']]></enumeration>
				<comment><![CDATA[Current status of the group buy]]></comment>
			</column>
			<column name="creator_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[User ID who created the group buy]]></comment>
			</column>
			<column name="seller_id" type="CHAR" length="36" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Seller Detailed ID if a specific seller is involved]]></comment>
			</column>
			<column name="conversation_id" type="VARCHAR" length="36" >
				<comment><![CDATA[Reference to group conversation in messaging system (UUID)]]></comment>
			</column>
			<column name="location" type="VARCHAR" length="255" >
				<comment><![CDATA[Location for pickup/delivery]]></comment>
			</column>
			<column name="deadline" type="DATETIME" mandatory="y" >
				<comment><![CDATA[Deadline for joining the group buy]]></comment>
			</column>
			<column name="deadline_extended_at" type="DATETIME" >
				<comment><![CDATA[Timestamp when the deadline was last extended]]></comment>
			</column>
			<column name="delivery_date" type="DATETIME" >
				<comment><![CDATA[Expected delivery date when successful]]></comment>
			</column>
			<column name="terms_conditions" type="TEXT" >
				<comment><![CDATA[Terms and conditions for the group buy]]></comment>
			</column>
			<column name="tags" type="JSON" >
				<comment><![CDATA[Array of tags for categorization]]></comment>
			</column>
			<column name="is_featured" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this group buy is featured]]></comment>
			</column>
			<column name="views_count" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of views on this group buy]]></comment>
			</column>
			<column name="savedCount" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of times this group buy has been saved (standardized field)]]></comment>
			</column>
			<column name="is_boosted" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether group buy is currently boosted]]></comment>
			</column>
			<column name="boost_expires_at" type="DATETIME" >
				<comment><![CDATA[When boost expires]]></comment>
			</column>
			<column name="boost_id" type="INT" >
				<comment><![CDATA[Reference to promotional boost]]></comment>
			</column>
			<column name="is_top_placed" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether group buy is currently top placed]]></comment>
			</column>
			<column name="top_placement_expires_at" type="DATETIME" >
				<comment><![CDATA[When top placement expires]]></comment>
			</column>
			<column name="top_placement_id" type="INT" >
				<comment><![CDATA[Reference to top_placements table]]></comment>
			</column>
			<column name="is_spotlighted" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether group buy is currently in spotlight]]></comment>
			</column>
			<column name="spotlight_expires_at" type="DATETIME" >
				<comment><![CDATA[When spotlight expires]]></comment>
			</column>
			<column name="spotlight_id" type="INT" >
				<comment><![CDATA[Reference to spotlight_slots table]]></comment>
			</column>
			<column name="visibility_score" type="DECIMAL" length="10" decimal="2" mandatory="y" >
				<defo><![CDATA['0.00']]></defo>
				<comment><![CDATA[Calculated visibility score for ranking]]></comment>
			</column>
			<column name="last_score_update" type="DATETIME" >
				<comment><![CDATA[When visibility score was last calculated]]></comment>
			</column>
			<column name="createdAt" type="DATETIME" />
			<column name="updatedAt" type="DATETIME" />
			<index name="pk_group_buys" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="seller_id" unique="NORMAL" >
				<column name="seller_id" />
			</index>
			<index name="group_buys_category" unique="NORMAL" >
				<column name="category" />
			</index>
			<index name="group_buys_creator_id" unique="NORMAL" >
				<column name="creator_id" />
			</index>
			<index name="group_buys_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="group_buys_deadline" unique="NORMAL" >
				<column name="deadline" />
			</index>
			<index name="group_buys_is_featured" unique="NORMAL" >
				<column name="is_featured" />
			</index>
			<fk name="group_buys_ibfk_1" to_schema="ocean_app_db" to_table="users" delete_action="cascade" update_action="cascade" options="" >
				<fk_column name="creator_id" pk="id" />
			</fk>
			<fk name="group_buys_ibfk_2" to_schema="ocean_app_db" to_table="users" delete_action="setNull" update_action="cascade" options="" >
				<fk_column name="seller_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci]]></options>
		</table>
		<table name="heavy_distributors" row_count="0" spec="" >
			<column name="id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
			</column>
			<column name="supplierId" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Reference to the supplier/seller]]></comment>
			</column>
			<column name="businessName" type="VARCHAR" length="200" mandatory="y" >
				<comment><![CDATA[Official business name of the distributor]]></comment>
			</column>
			<column name="businessType" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['manufacturer','wholesaler','distributor','retailer','importer','exporter']]></enumeration>
				<comment><![CDATA[Type of business operation]]></comment>
			</column>
			<column name="productCategories" type="JSON" mandatory="y" >
				<comment><![CDATA[Array of product categories this distributor handles]]></comment>
			</column>
			<column name="productBrands" type="JSON" >
				<comment><![CDATA[Array of product brands this distributor carries]]></comment>
			</column>
			<column name="minimumOrderQuantity" type="INT" >
				<comment><![CDATA[Minimum quantity required for wholesale orders]]></comment>
			</column>
			<column name="minimumOrderValue" type="DECIMAL" length="12" decimal="2" >
				<comment><![CDATA[Minimum order value in local currency]]></comment>
			</column>
			<column name="paymentTerms" type="JSON" >
				<comment><![CDATA[Payment terms and conditions (e.g., net 30, upfront, etc.)]]></comment>
			</column>
			<column name="deliveryOptions" type="JSON" >
				<comment><![CDATA[Available delivery options and costs]]></comment>
			</column>
			<column name="coverageAreas" type="JSON" mandatory="y" >
				<comment><![CDATA[Geographic areas this distributor covers (states, cities, regions)]]></comment>
			</column>
			<column name="contactInfo" type="JSON" mandatory="y" >
				<comment><![CDATA[Contact information including phone, email, website]]></comment>
			</column>
			<column name="businessAddress" type="TEXT" mandatory="y" >
				<comment><![CDATA[Physical business address]]></comment>
			</column>
			<column name="operatingHours" type="JSON" >
				<comment><![CDATA[Business operating hours and days]]></comment>
			</column>
			<column name="certifications" type="JSON" >
				<comment><![CDATA[Business certifications and licenses]]></comment>
			</column>
			<column name="yearsInBusiness" type="INT" >
				<comment><![CDATA[Number of years the business has been operating]]></comment>
			</column>
			<column name="employeeCount" type="ENUM" >
				<enumeration><![CDATA['1-10','11-50','51-200','201-500','500+']]></enumeration>
				<comment><![CDATA[Number of employees]]></comment>
			</column>
			<column name="annualRevenue" type="ENUM" >
				<enumeration><![CDATA['under_1m','1m_5m','5m_25m','25m_100m','over_100m']]></enumeration>
				<comment><![CDATA[Annual revenue range]]></comment>
			</column>
			<column name="isVerified" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this distributor has been verified by Ocean]]></comment>
			</column>
			<column name="verificationDate" type="DATETIME" >
				<comment><![CDATA[Date when verification was completed]]></comment>
