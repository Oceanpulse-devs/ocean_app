			</index>
			<index name="distributor_inquiries_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="distributor_inquiries_priority" unique="NORMAL" >
				<column name="priority" />
			</index>
			<index name="distributor_inquiries_urgency_level" unique="NORMAL" >
				<column name="urgencyLevel" />
			</index>
			<index name="distributor_inquiries_created_at" unique="NORMAL" >
				<column name="createdAt" />
			</index>
			<fk name="distributor_inquiries_ibfk_1" to_schema="ocean_app_db" to_table="users" update_action="cascade" options="" >
				<fk_column name="inquirerId" pk="id" />
