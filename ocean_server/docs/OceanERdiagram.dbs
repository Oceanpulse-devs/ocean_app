				<comment><![CDATA[ID of the buyer need being responded to]]></comment>
			</column>
			<column name="seller_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[User ID of the seller responding]]></comment>
			</column>
			<column name="message" type="TEXT" mandatory="y" >
				<comment><![CDATA[Seller's response message to the buyer need]]></comment>
			</column>
			<column name="offer_price" type="DECIMAL" length="10" decimal="2" >
				<comment><![CDATA[Price offered by the seller (if applicable)]]></comment>
			</column>
			<column name="currency" type="VARCHAR" length="3" mandatory="y" >
				<defo><![CDATA['USD']]></defo>
				<comment><![CDATA[Currency for the offer price]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['pending']]></defo>
				<enumeration><![CDATA['pending','accepted','rejected','expired','withdrawn']]></enumeration>
				<comment><![CDATA[Status of the seller response]]></comment>
			</column>
			<column name="is_featured" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this response is featured]]></comment>
			</column>
			<column name="response_type" type="ENUM" >
				<defo><![CDATA['offer']]></defo>
				<enumeration><![CDATA['offer','inquiry','suggestion','other']]></enumeration>
				<comment><![CDATA[Type of response from seller]]></comment>
			</column>
			<column name="delivery_time" type="VARCHAR" length="100" >
				<comment><![CDATA[Estimated delivery time offered by seller]]></comment>
			</column>
			<column name="warranty_info" type="TEXT" >
				<comment><![CDATA[Warranty information if applicable]]></comment>
			</column>
			<column name="return_policy" type="TEXT" >
				<comment><![CDATA[Return policy if applicable]]></comment>
			</column>
			<column name="contact_method" type="ENUM" mandatory="y" >
				<enumeration><![CDATA['message','email','phone','meet']]></enumeration>
				<comment><![CDATA[Preferred contact method for this response]]></comment>
			</column>
			<column name="is_read" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether the buyer has read this response]]></comment>
			</column>
			<column name="buyer_feedback" type="ENUM" >
				<enumeration><![CDATA['positive','neutral','negative']]></enumeration>
				<comment><![CDATA[Buyer feedback on this response]]></comment>
			</column>
			<column name="created_at" type="DATETIME" />
			<column name="updated_at" type="DATETIME" />
			<index name="pk_buyer_need_responses" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="buyer_need_responses_buyer_need_id_seller_id" unique="UNIQUE_KEY" >
				<column name="buyer_need_id" />
				<column name="seller_id" />
			</index>
			<index name="buyer_need_responses_buyer_need_id" unique="NORMAL" >
				<column name="buyer_need_id" />
			</index>
			<index name="buyer_need_responses_seller_id" unique="NORMAL" >
				<column name="seller_id" />
			</index>
			<index name="buyer_need_responses_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="buyer_need_responses_is_featured" unique="NORMAL" >
				<column name="is_featured" />
			</index>
			<index name="buyer_need_responses_created_at" unique="NORMAL" >
				<column name="created_at" />
			</index>
			<fk name="buyer_need_responses_ibfk_1" to_schema="ocean_app_db" to_table="buyer_needs" delete_action="cascade" update_action="cascade" options="" >
				<fk_column name="buyer_need_id" pk="id" />
			</fk>
			<fk name="buyer_need_responses_ibfk_2" to_schema="ocean_app_db" to_table="users" update_action="cascade" options="" >
				<fk_column name="seller_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci]]></options>
		</table>
		<table name="buyer_needs" row_count="0" spec="" >
			<column name="id" type="INT" mandatory="y" >
				<identity><![CDATA[AUTO_INCREMENT]]></identity>
			</column>
			<column name="title" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Title describing what the buyer is looking for]]></comment>
			</column>
			<column name="description" type="TEXT" mandatory="y" >
				<comment><![CDATA[Detailed description of the item/service needed]]></comment>
			</column>
			<column name="buyer_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[User ID who posted this buyer need]]></comment>
			</column>
			<column name="category_id" type="CHAR" length="36" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[Product category for the buyer need (optional) - kept for backward compatibility]]></comment>
			</column>
			<column name="category" type="VARCHAR" length="255" >
				<comment><![CDATA[Category name (string) - stored directly, not using ProductCategory table anymore]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['active']]></defo>
				<enumeration><![CDATA['active','in_progress','fulfilled','expired','cancelled']]></enumeration>
				<comment><![CDATA[Current status of the buyer need]]></comment>
			</column>
			<column name="is_featured" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this buyer need is featured]]></comment>
			</column>
			<column name="views_count" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of views on this buyer need]]></comment>
			</column>
			<column name="responses_count" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of seller responses received]]></comment>
			</column>
			<column name="expires_at" type="DATETIME" >
				<comment><![CDATA[When this buyer need expires]]></comment>
			</column>
			<column name="reach_limit" type="INT" mandatory="y" >
				<defo><![CDATA['5']]></defo>
				<comment><![CDATA[Maximum number of people who can contact the buyer]]></comment>
			</column>
			<column name="current_reach" type="INT" mandatory="y" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Current number of people who have contacted the buyer]]></comment>
			</column>
			<column name="reach_exceeded" type="BOOLEAN" mandatory="y" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether the reach limit has been exceeded]]></comment>
			</column>
			<column name="created_at" type="DATETIME" />
			<column name="updated_at" type="DATETIME" />
			<index name="pk_buyer_needs" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="buyer_needs_buyer_id" unique="NORMAL" >
				<column name="buyer_id" />
			</index>
			<index name="buyer_needs_category_id" unique="NORMAL" >
				<column name="category_id" />
			</index>
			<index name="buyer_needs_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="buyer_needs_is_featured" unique="NORMAL" >
				<column name="is_featured" />
			</index>
			<index name="buyer_needs_expires_at" unique="NORMAL" >
				<column name="expires_at" />
			</index>
			<index name="buyer_needs_created_at" unique="NORMAL" >
				<column name="created_at" />
			</index>
			<index name="buyer_needs_reach_exceeded_current_reach" unique="NORMAL" >
				<column name="reach_exceeded" />
				<column name="current_reach" />
			</index>
			<index name="buyer_needs_status_reach_exceeded" unique="NORMAL" >
				<column name="status" />
				<column name="reach_exceeded" />
			</index>
			<fk name="buyer_needs_ibfk_1" to_schema="ocean_app_db" to_table="users" update_action="cascade" options="" >
				<fk_column name="buyer_id" pk="id" />
			</fk>
