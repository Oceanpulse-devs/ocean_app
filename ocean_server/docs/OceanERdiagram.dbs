		<table name="swap_deals" row_count="0" spec="" >
			<column name="id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
			</column>
			<column name="seller_id" type="CHAR" length="36" mandatory="y" >
				<column_options><![CDATA[CHARACTER SET utf8mb4 COLLATE utf8mb4_bin]]></column_options>
				<comment><![CDATA[User ID who created the swap deal (seller)]]></comment>
			</column>
			<column name="product_to_swap" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Name of the product being swapped]]></comment>
			</column>
			<column name="category_to_swap" type="VARCHAR" length="100" mandatory="y" >
				<comment><![CDATA[Category of the product being swapped]]></comment>
			</column>
			<column name="brand_to_swap" type="VARCHAR" length="100" >
				<comment><![CDATA[Brand of the product being swapped]]></comment>
			</column>
			<column name="condition" type="ENUM" >
				<defo><![CDATA['Good']]></defo>
				<enumeration><![CDATA['New','Like New','Good','Fair','Poor']]></enumeration>
				<comment><![CDATA[Condition of the product being swapped]]></comment>
			</column>
			<column name="preferred_swap_category" type="VARCHAR" length="100" >
				<comment><![CDATA[Category the seller wants to swap with]]></comment>
			</column>
			<column name="preferred_swap_subcategories" type="JSON" >
				<comment><![CDATA[JSON array of preferred subcategories]]></comment>
			</column>
			<column name="swap_conditions" type="TEXT" >
				<comment><![CDATA[Swap deal conditions and preferences]]></comment>
			</column>
			<column name="title" type="VARCHAR" length="255" mandatory="y" >
				<comment><![CDATA[Title of the swap deal]]></comment>
			</column>
			<column name="description" type="TEXT" mandatory="y" >
				<comment><![CDATA[Detailed description of the swap deal]]></comment>
			</column>
			<column name="images" type="JSON" >
				<comment><![CDATA[JSON array of image URLs for the swap deal]]></comment>
			</column>
			<column name="ar_model" type="VARCHAR" length="500" >
				<comment><![CDATA[URL to GLB file for AR model viewing]]></comment>
			</column>
			<column name="swap_terms" type="TEXT" >
				<comment><![CDATA[Additional terms or conditions for the swap]]></comment>
			</column>
			<column name="preferred_items" type="TEXT" >
				<comment><![CDATA[What the seller wants in exchange]]></comment>
			</column>
			<column name="meeting_location" type="VARCHAR" length="255" >
				<comment><![CDATA[Preferred meeting location for item exchange]]></comment>
			</column>
			<column name="meeting_date" type="DATE" >
				<comment><![CDATA[Preferred meeting date for item exchange]]></comment>
			</column>
			<column name="status" type="ENUM" >
				<defo><![CDATA['active']]></defo>
				<enumeration><![CDATA['active','inactive','completed','cancelled']]></enumeration>
				<comment><![CDATA[Current status of the swap deal]]></comment>
			</column>
			<column name="views_count" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of views on this swap deal]]></comment>
			</column>
			<column name="savedCount" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of times this swap deal has been saved (standardized field)]]></comment>
			</column>
			<column name="proposals_count" type="INT" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Number of swap proposals received]]></comment>
			</column>
			<column name="is_featured" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether this swap deal is featured]]></comment>
			</column>
			<column name="is_boosted" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether swap deal is currently boosted]]></comment>
			</column>
			<column name="boost_expires_at" type="DATETIME" >
				<comment><![CDATA[When boost expires]]></comment>
			</column>
			<column name="boost_id" type="INT" >
				<comment><![CDATA[Reference to promotional boost]]></comment>
			</column>
			<column name="is_top_placed" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether swap deal is currently top placed]]></comment>
			</column>
			<column name="top_placement_expires_at" type="DATETIME" >
				<comment><![CDATA[When top placement expires]]></comment>
			</column>
			<column name="top_placement_id" type="INT" >
				<comment><![CDATA[Reference to top_placements table]]></comment>
			</column>
			<column name="is_spotlighted" type="BOOLEAN" >
				<defo><![CDATA['0']]></defo>
				<comment><![CDATA[Whether swap deal is currently in spotlight]]></comment>
			</column>
			<column name="spotlight_expires_at" type="DATETIME" >
				<comment><![CDATA[When spotlight expires]]></comment>
			</column>
			<column name="spotlight_id" type="INT" >
				<comment><![CDATA[Reference to spotlight_slots table]]></comment>
			</column>
			<column name="visibility_score" type="DECIMAL" length="10" decimal="2" mandatory="y" >
				<defo><![CDATA['0.00']]></defo>
				<comment><![CDATA[Calculated visibility score for ranking]]></comment>
			</column>
			<column name="last_score_update" type="DATETIME" >
				<comment><![CDATA[When visibility score was last calculated]]></comment>
			</column>
			<column name="expires_at" type="DATETIME" >
				<comment><![CDATA[When the swap offer expires]]></comment>
			</column>
			<column name="createdAt" type="DATETIME" />
			<column name="updatedAt" type="DATETIME" />
			<index name="pk_swap_deals" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="swap_deals_seller_id" unique="NORMAL" >
				<column name="seller_id" />
			</index>
			<index name="swap_deals_status" unique="NORMAL" >
				<column name="status" />
			</index>
			<index name="swap_deals_is_featured" unique="NORMAL" >
				<column name="is_featured" />
			</index>
			<index name="swap_deals_expires_at" unique="NORMAL" >
				<column name="expires_at" />
			</index>
			<index name="swap_deals_created_at" unique="NORMAL" >
				<column name="createdAt" />
			</index>
			<fk name="swap_deals_ibfk_1" to_schema="ocean_app_db" to_table="users" update_action="cascade" options="" >
				<fk_column name="seller_id" pk="id" />
			</fk>
			<options><![CDATA[ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci]]></options>
		</table>
