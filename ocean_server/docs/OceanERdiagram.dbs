				<comment><![CDATA[When boost starts]]></comment>
			</column>
			<column name="end_time" type="DATETIME" mandatory="y" >
				<comment><![CDATA[When boost ends]]></comment>
			</column>
			<column name="boost_reason" type="VARCHAR" length="255" >
				<comment><![CDATA[Reason for boost]]></comment>
			</column>
