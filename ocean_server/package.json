{
  "name": "ocean_server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --require ./instrumentation.js server.js",
    "pro": "npx sequelize-cli db:migrate && node --require ./instrumentation.js server.js",
    "start": "npx sequelize-cli db:migrate && node --require ./instrumentation.js server.js",
    "test": "jest",
    "test:admin": "node scripts/testAdmin.js",
    "test:admin:performance": "node scripts/testAdmin.js --performance",
    "test:admin:security": "node scripts/testAdmin.js --security",
    "test:admin:all": "node scripts/testAdmin.js --all",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:auction": "node scripts/runTestWithLog.js auctionController",
    "test:product": "node scripts/runTestWithLog.js productController",
    "test:groupbuy": "node scripts/runTestWithLog.js groupBuyController",
    "test:subscription": "node scripts/runTestWithLog.js subscriptionController",
    "test:swapdeal": "node scripts/runTestWithLog.js swapDealController",
    "test:distresssale": "node scripts/runTestWithLog.js distressSaleController",
    "test:notification": "node scripts/runTestWithLog.js notificationController",
    "test:buyerneed": "node scripts/runTestWithLog.js buyerNeedController",
    "test:clear-logs": "node -e \"require('fs').rmSync('test-logs', {recursive: true, force: true}); console.log('✅ Logs cleared')\""
  },
