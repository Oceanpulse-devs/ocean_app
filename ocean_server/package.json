    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^13.6.0",
    "fluent-ffmpeg": "^2.1.3",
