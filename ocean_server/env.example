# Railway Database Configuration
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DB_HOST=your_mysql_host
DB_PORT=3306

# Node Environment
NODE_ENV=production
PORT=5000

# Session Secret
SESSION_SECRET=your_very_secure_session_secret_here

# Frontend URL for CORS
FRONTEND_URL=https://your-frontend-domain.com

# Mobile App Configuration
MOBILE_APP_URL=https://your-mobile-app-domain.com
MOBILE_APP_VERSION=1.0.0
MOBILE_API_VERSION=v1

# Message Server URL
MESSAGE_SERVER_URL=https://messageserver-production-88ba.up.railway.app

# Redis Configuration (if using Redis)
REDIS_URL=your_redis_url

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Payment Providers Configuration
# Paystack Configuration
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Flutterwave Configuration
FLW_CLIENT_ID=your_flutterwave_client_id
FLW_CLIENT_SECRET=your_flutterwave_client_secret
FLW_PUBLIC_KEY=your_flutterwave_public_key
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_ENCRYPTION_KEY=your_flutterwave_encryption_key
# For testing (sandbox): https://developersandbox-api.flutterwave.com/v3
# For production: https://api.flutterwave.com/v3
FLW_BASE_URL=https://developersandbox-api.flutterwave.com/v3

# Default Payment Provider (flutterwave, mock)
PAYMENT_PROVIDER=flutterwave

# Base URL for callbacks
BASE_URL=https://your-backend-domain.com
APP_LOGO_URL=https://your-app-logo-url.com/logo.png