{
	"info": {
		"_postman_id": "ocean-user-profile-collection",
		"name": "Ocean - User Profile",
		"description": "Complete collection for Ocean app user profile and session management endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Profile Management",
			"item": [
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"profile"
							]
						},
						"description": "Get current user's profile information"
					},
					"response": []
				},
				{
					"name": "Get User Profile by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/{{userId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}"
							]
						},
						"description": "Get another user's profile by ID"
					},
					"response": []
				},
				{
					"name": "Update Profile (Form Data)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "fullName",
									"value": "John Doe Updated",
									"type": "text"
								},
								{
									"key": "bio",
									"value": "Updated bio information with real profile picture",
									"type": "text"
								},
								{
									"key": "location",
									"value": "San Francisco, CA",
									"type": "text"
								},
								{
									"key": "website",
									"value": "https://johndoe.com",
									"type": "text"
								},
								{
									"key": "profilePicture",
									"type": "file",
									"src": []
								},
								{
									"key": "coverPicture",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"profile"
							]
						},
						"description": "Update current user's profile with real image uploads using form-data"
					},
					"response": []
				},
				{
					"name": "Update Profile (JSON)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"John Doe Updated\",\n  \"bio\": \"Updated bio information\",\n  \"location\": \"San Francisco, CA\",\n  \"website\": \"https://johndoe.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"profile"
							]
						},
						"description": "Update current user's profile information using JSON (without image uploads)"
					},
					"response": []
				}
			],
			"description": "User profile management endpoints"
