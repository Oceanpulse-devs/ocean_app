							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyName\": \"Mega Electronics Distributors\",\n  \"businessType\": \"wholesale_distributor\",\n  \"description\": \"Leading distributor of electronics and technology products\",\n  \"categories\": [\"Electronics\", \"Technology\", \"Gadgets\"],\n  \"capacity\": {\n    \"storageCapacity\": 50000,\n    \"monthlyVolume\": 1000000,\n    \"unit\": \"sq_ft\"\n  },\n  \"location\": {\n    \"address\": \"123 Distribution Center Blvd\",\n    \"city\": \"Los Angeles\",\n    \"state\": \"CA\",\n    \"zipCode\": \"90210\",\n    \"country\": \"USA\",\n    \"coordinates\": {\n      \"latitude\": 34.0522,\n      \"longitude\": -118.2437\n    }\n  },\n  \"contactInfo\": {\n    \"phone\": \"+1234567890\",\n    \"email\": \"contact@megadistributors.com\",\n    \"website\": \"https://megadistributors.com\",\n    \"contactPerson\": \"John Smith\"\n  },\n  \"businessDetails\": {\n    \"licenseNumber\": \"DL123456789\",\n    \"taxId\": \"12-3456789\",\n    \"yearsInBusiness\": 15,\n    \"employeeCount\": 250\n  },\n  \"services\": [\"bulk_sales\", \"wholesale\", \"logistics\", \"custom_packaging\"],\n  \"minimumOrder\": {\n    \"amount\": 10000,\n    \"currency\": \"USD\"\n  },\n  \"paymentTerms\": [\"net_30\", \"net_60\", \"cash_on_delivery\"],\n  \"shippingOptions\": {\n    \"localDelivery\": true,\n    \"nationwideShipping\": true,\n    \"internationalShipping\": false,\n    \"freightOptions\": true\n  },\n  \"certifications\": [\"ISO_9001\", \"FDA_approved\", \"CE_certified\"],\n  \"images\": [\"https://example.com/warehouse1.jpg\", \"https://example.com/warehouse2.jpg\"],\n  \"tags\": [\"wholesale\", \"bulk\", \"electronics\", \"distribution\"]\n}"
						},
