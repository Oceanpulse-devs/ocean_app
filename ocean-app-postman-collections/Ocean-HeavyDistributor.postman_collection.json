						"body": {
							"mode": "raw",
							"raw": "{\n  \"distributorId\": \"{{distributorId}}\",\n  \"inquiryType\": \"bulk_purchase\",\n  \"subject\": \"Bulk Electronics Purchase Inquiry\",\n  \"message\": \"We are interested in purchasing electronics in bulk for our retail chain. Please provide pricing and availability.\",\n  \"requirements\": {\n    \"productCategory\": \"Electronics\",\n    \"quantity\": 5000,\n    \"budget\": {\n      \"min\": 50000,\n      \"max\": 100000,\n      \"currency\": \"USD\"\n    },\n    \"deliveryDate\": \"2024-03-15T00:00:00Z\",\n    \"deliveryLocation\": {\n      \"city\": \"New York\",\n      \"state\": \"NY\",\n      \"country\": \"USA\"\n    }\n  },\n  \"contactInfo\": {\n    \"phone\": \"+1234567890\",\n    \"email\": \"buyer@retailchain.com\",\n    \"companyName\": \"Retail Chain Inc.\"\n  },\n  \"urgency\": \"medium\",\n  \"preferredContactMethod\": \"email\"\n}"
						},
