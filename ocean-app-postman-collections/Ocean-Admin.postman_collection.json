						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"newStatus\": \"suspended\",\n  \"reason\": \"Violation of community guidelines\",\n  \"adminNotes\": \"User reported for inappropriate behavior. Suspended for 7 days.\",\n  \"actionBy\": \"{{adminUserId}}\",\n  \"suspensionDuration\": 7,\n  \"suspensionUnit\": \"days\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/toggle-user-status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"toggle-user-status"
							]
						},
						"description": "Toggle user status (active/suspended/banned)"
					},
					"response": []
				}
