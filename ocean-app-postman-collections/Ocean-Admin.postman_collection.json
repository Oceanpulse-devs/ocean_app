						"url": {
							"raw": "{{base_url}}/api/admin/stats?period=30d&includeDetails=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"stats"
							],
							"query": [
								{
									"key": "period",
									"value": "30d",
									"description": "Time period for statistics (7d, 30d, 90d, 1y)"
