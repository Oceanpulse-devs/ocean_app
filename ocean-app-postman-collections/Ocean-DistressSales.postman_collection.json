{
	"info": {
		"_postman_id": "ocean-distress-sales-collection",
		"name": "Ocean - Distress Sales",
		"description": "Complete collection for Ocean app distress sales endpoints. Updated for Universal Category System - supports both UUID and name-based category lookup.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Public Routes",
			"item": [
				{
					"name": "Get All Distress Sales",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/all?page=1&limit=20&category={{tech_category_id}}&urgency=high",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"all"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page"
								},
								{
									"key": "category",
									"value": "{{tech_category_id}}",
									"description": "Filter by category ID (UUID or name)"
								},
								{
									"key": "urgency",
									"value": "high",
									"description": "Filter by urgency (low, medium, high, critical)"
								}
							]
						},
						"description": "Get all distress sales (public access)"
					},
					"response": []
				},
