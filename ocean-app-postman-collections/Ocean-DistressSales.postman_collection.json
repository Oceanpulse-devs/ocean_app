					"name": "Get Distress Sale Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/stats?period=30d",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"stats"
							],
							"query": [
								{
									"key": "period",
									"value": "30d",
									"description": "Time period for statistics"
								}
							]
						},
						"description": "Get distress sales statistics"
					},
					"response": []
				},
				{
					"name": "Get Distress Sale by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/{{distressSaleId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"{{distressSaleId}}"
							]
						},
						"description": "Get specific distress sale details"
					},
					"response": []
				}
			],
			"description": "Public distress sales routes (no authentication required)"
