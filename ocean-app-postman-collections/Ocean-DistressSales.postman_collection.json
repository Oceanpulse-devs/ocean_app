{
	"info": {
		"_postman_id": "ocean-distress-sales-collection",
		"name": "Ocean - Distress Sales",
		"description": "Complete collection for Ocean app distress sales endpoints. Updated for Universal Category System - supports both UUID and name-based category lookup.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Public Routes",
			"item": [
				{
					"name": "Get All Distress Sales",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/all?page=1&limit=20&category={{tech_category_id}}&urgency=high",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"all"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page"
								},
								{
									"key": "category",
									"value": "{{tech_category_id}}",
									"description": "Filter by category ID (UUID or name)"
								},
								{
									"key": "urgency",
									"value": "high",
									"description": "Filter by urgency (low, medium, high, critical)"
								}
							]
						},
						"description": "Get all distress sales (public access)"
					},
					"response": []
				},
				{
					"name": "Get Distress Sale Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/stats?period=30d",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"stats"
							],
							"query": [
								{
									"key": "period",
									"value": "30d",
									"description": "Time period for statistics"
								}
							]
						},
						"description": "Get distress sales statistics"
					},
					"response": []
				},
				{
					"name": "Get Distress Sale by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/{{distressSaleId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"{{distressSaleId}}"
							]
						},
						"description": "Get specific distress sale details"
					},
					"response": []
				}
			],
			"description": "Public distress sales routes (no authentication required)"
		},
		{
			"name": "Protected Routes",
			"item": [
				{
					"name": "Create Distress Sale",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"URGENT: Electronics Liquidation Sale\",\n  \"description\": \"Need to liquidate electronics inventory immediately due to business closure\",\n  \"category\": \"{{tech_category_id}}\",\n  \"urgency\": \"critical\",\n  \"reason\": \"business_closure\",\n  \"originalPrice\": 5000.00,\n  \"distressPrice\": 2500.00,\n  \"discountPercentage\": 50,\n  \"quantity\": 25,\n  \"condition\": \"good\",\n  \"location\": {\n    \"address\": \"123 Business St\",\n    \"city\": \"Los Angeles\",\n    \"state\": \"CA\",\n    \"zipCode\": \"90210\",\n    \"country\": \"USA\"\n  },\n  \"contactInfo\": {\n    \"phone\": \"+1234567890\",\n    \"email\": \"seller@example.com\",\n    \"preferredContact\": \"phone\"\n  },\n  \"images\": [\"https://example.com/inventory1.jpg\", \"https://example.com/inventory2.jpg\"],\n  \"tags\": [\"electronics\", \"liquidation\", \"urgent\", \"bulk\"],\n  \"expiryDate\": \"2024-01-20T23:59:59Z\",\n  \"pickupRequired\": true,\n  \"shippingAvailable\": false,\n  \"minimumOrder\": 5,\n  \"bulkDiscount\": {\n    \"enabled\": true,\n    \"threshold\": 10,\n    \"additionalDiscount\": 10\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/distress-sales/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"create"
							]
						},
						"description": "Create a new distress sale"
					},
					"response": []
				},
				{
					"name": "Update Distress Sale",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated: Electronics Liquidation Sale\",\n  \"description\": \"Updated description with more details\",\n  \"distressPrice\": 2000.00,\n  \"discountPercentage\": 60,\n  \"urgency\": \"high\",\n  \"expiryDate\": \"2024-01-25T23:59:59Z\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/distress-sales/{{distressSaleId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"{{distressSaleId}}"
							]
						},
						"description": "Update distress sale details"
					},
					"response": []
				},
				{
					"name": "Delete Distress Sale",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/distress-sales/{{distressSaleId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"{{distressSaleId}}"
							]
						},
						"description": "Delete a distress sale"
					},
					"response": []
				},
				{
					"name": "Convert to Distress Sale",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"originalListingId\": \"{{originalListingId}}\",\n  \"originalListingType\": \"product\",\n  \"urgency\": \"medium\",\n  \"reason\": \"need_quick_sale\",\n  \"distressPrice\": 150.00,\n  \"discountPercentage\": 25,\n  \"expiryDate\": \"2024-01-30T23:59:59Z\",\n  \"notes\": \"Converting regular product listing to distress sale for quick liquidation\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/distress-sales/{{distressSaleId}}/convert",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"distress-sales",
								"{{distressSaleId}}",
								"convert"
							]
						},
						"description": "Convert existing listing to distress sale"
					},
					"response": []
				}
			],
			"description": "Protected distress sales routes (authentication required)"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "distressSaleId",
			"value": "",
			"type": "string"
		},
		{
			"key": "originalListingId",
			"value": "",
			"type": "string"
		}
	]
}
