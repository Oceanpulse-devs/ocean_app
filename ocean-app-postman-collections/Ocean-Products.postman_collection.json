							"raw": "{\n  \"name\": \"Sample Product\",\n  \"description\": \"This is a sample product description\",\n  \"price\": 99.99,\n  \"category\": \"Electronics\",\n  \"quantity\": 10,\n  \"images\": [\"https://example.com/image1.jpg\"],\n  \"tags\": [\"electronics\", \"gadgets\"],\n  \"condition\": \"new\",\n  \"location\": \"New York, NY\"\n}"
