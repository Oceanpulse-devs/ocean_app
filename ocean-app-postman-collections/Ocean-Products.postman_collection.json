									"value": "all",
									"description": "Filter: all, system, custom"
								},
								{
									"key": "sortBy",
									"value": "usageCount",
									"description": "Sort by: usageCount, name, createdAt"
								},
								{
									"key": "sortOrder",
									"value": "DESC",
									"description": "Sort order: ASC, DESC"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Results limit"
								},
								{
									"key": "minUsage",
									"value": "",
