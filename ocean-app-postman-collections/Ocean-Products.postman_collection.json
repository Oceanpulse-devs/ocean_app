							"raw": "{{base_url}}/api/categories?type=all",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"categories"
							],
							"query": [
								{
									"key": "type",
									"value": "all",
									"description": "all, system, custom"
