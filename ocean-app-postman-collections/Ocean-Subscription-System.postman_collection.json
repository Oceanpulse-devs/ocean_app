		{
			"name": "Payment Processing",
			"item": [
				{
					"name": "Confirm Payment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"paymentReference\": \"OCEAN_SUB_1234567890_abc123\",\n  \"paymentMethod\": \"flutterwave\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/subscriptions/verify-payment",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"verify-payment"
							]
						},
						"description": "Verify payment and update subscription status. Use this to manually verify a payment reference from Flutterwave."
					},
					"response": []
				}
			]
		},
		{
			"name": "Payment Webhooks",
			"item": [
				{
					"name": "Flutterwave Webhook Test",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "verif-hash",
								"value": "{{flw_encryption_key}}",
								"type": "text",
								"description": "Flutterwave secret hash (must match FLW_ENCRYPTION_KEY)"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"subscription.charged\",\n  \"data\": {\n    \"id\": \"12345\",\n    \"subscription\": {\n      \"id\": \"67890\"\n    },\n    \"tx_ref\": \"OCEAN_SUB_1234567890_abc123\",\n    \"flw_ref\": \"FLW_REF_123456\",\n    \"amount\": 3000,\n    \"currency\": \"NGN\",\n    \"created_at\": \"2026-01-13T20:48:39.000Z\",\n    \"next_payment_date\": \"2026-02-13T20:48:39.000Z\",\n    \"meta\": {\n      \"userId\": \"user-uuid-here\",\n      \"planId\": \"2\"\n    }\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/subscriptions/webhooks/flutterwave",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"webhooks",
								"flutterwave"
							]
						},
						"description": "Test Flutterwave webhook endpoint for subscription events.\n\n**Supported Events:**\n- `subscription.charged` - Subscription payment successful\n- `subscription.renewed` - Subscription renewed\n- `subscription.cancelled` - Subscription cancelled\n- `subscription.activated` - Subscription activated\n- `charge.completed` - One-time payment completed\n\n**Headers:**\n- `verif-hash`: Must match your FLW_ENCRYPTION_KEY from environment variables"
					},
					"response": []
				},
				{
					"name": "Flutterwave Webhook Test (GET)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/subscriptions/webhooks/flutterwave",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"webhooks",
								"flutterwave"
							]
						},
						"description": "Test webhook endpoint accessibility. Returns success message if endpoint is reachable."
					},
					"response": []
				}
			]
		}
