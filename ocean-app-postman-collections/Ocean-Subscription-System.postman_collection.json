					},
					"response": []
				}
			]
		},
		{
			"name": "User Subscriptions",
			"item": [
				{
					"name": "Subscribe to Plan",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"planId\": \"wave\",\n  \"skipTrial\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/subscriptions/subscribe",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"subscribe"
							]
						},
						"description": "Subscribe to a plan using Flutterwave recurring billing.\n\n**Request Body:**\n- `planId` (required): Plan name - \"drift\", \"wave\", \"tide\", or \"surge\"\n- `skipTrial` (optional): Set to `true` to skip free trial and pay immediately\n\n**Response:**\n- If eligible for trial and `skipTrial=false`: Returns trial subscription (no payment needed)\n- If not eligible or `skipTrial=true`: Returns Flutterwave subscription checkout URL for recurring billing\n\n**Note:** User must be a verified seller to subscribe. Currency (NGN/USD) is automatically determined based on seller's country."
					},
					"response": []
				},
				{
					"name": "Change Subscription Plan",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newPlanId\": \"tide\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/subscriptions/change-plan",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"change-plan"
							]
						},
						"description": "Change user's subscription plan (upgrade/downgrade). Cancels existing Flutterwave subscription and creates new one. Returns Flutterwave checkout URL for new plan."
					},
					"response": []
				},
				{
					"name": "Cancel Subscription",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"No longer needed\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/subscriptions/cancel",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"cancel"
							]
						},
						"description": "Cancel user's subscription. Cancels both the database subscription and the Flutterwave recurring subscription. Subscription will remain active until the end of the current billing period."
					},
					"response": []
				}
			]
		},
