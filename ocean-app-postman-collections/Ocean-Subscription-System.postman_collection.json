			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "flw_encryption_key",
			"value": "",
			"type": "string",
			"description": "Flutterwave encryption key (FLW_ENCRYPTION_KEY) for webhook verification"
		}
	]
