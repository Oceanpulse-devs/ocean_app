{
	"info": {
		"_postman_id": "ocean-market-analytics-collection",
		"name": "Ocean - Market Analytics",
		"description": "Complete collection for Ocean app market analytics and insights endpoints. Updated for Universal Category System - supports both UUID and name-based category lookup.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Core Analytics",
			"item": [
				{
					"name": "Track Metric",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"metricType\": \"product_view\",\n  \"entityId\": \"{{productId}}\",\n  \"entityType\": \"product\",\n  \"userId\": \"{{userId}}\",\n  \"metadata\": {\n    \"category\": \"{{tech_category_id}}\",\n    \"price\": 299.99,\n    \"location\": \"New York\"\n  },\n  \"timestamp\": \"2024-01-15T10:30:00Z\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/market-analytics/track",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market-analytics",
								"track"
							]
						},
						"description": "Track a market metric event"
					},
					"response": []
				},
				{
					"name": "Get Market Overview",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/market-analytics/overview?period=30d&includeTrends=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"market-analytics",
								"overview"
							],
							"query": [
								{
									"key": "period",
									"value": "30d",
									"description": "Time period (7d, 30d, 90d, 1y)"
								},
								{
									"key": "includeTrends",
									"value": "true",
									"description": "Include trend analysis"
								}
							]
						},
						"description": "Get overall market analytics overview"
					},
					"response": []
				},
