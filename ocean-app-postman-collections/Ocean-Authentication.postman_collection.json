				{
					"name": "Seller Registration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "businessName",
									"value": "John's Electronics Store",
									"type": "text",
									"description": "Business name (required)"
								},
								{
									"key": "businessAddress",
									"value": "123 Business St, New York, NY 10001, USA",
									"type": "text",
									"description": "Complete business address (required)"
								},
								{
									"key": "businessDescription",
									"value": "We specialize in selling high-quality electronics including smartphones, laptops, and accessories. Our store has been serving customers for over 10 years with excellent customer service.",
									"type": "text",
									"description": "Detailed business description (required)"
								},
								{
									"key": "sellerTypes",
									"value": "[\"retailer\", \"wholesaler\"]",
									"type": "text",
									"description": "Array of seller types: retailer, wholesaler, distributor, manufacturer (required)"
								},
								{
									"key": "selectedCategories",
									"value": "[\"Electronics\", \"Clothing & Fashion\"]",
									"type": "text",
									"description": "Array of main categories (1-3 categories required)"
								},
								{
									"key": "selectedSubcategories",
									"value": "{\"Electronics\": [\"Smartphones\", \"Laptops\", \"Accessories\"], \"Clothing & Fashion\": [\"Men's Clothing\", \"Women's Clothing\"]}",
									"type": "text",
									"description": "JSON object mapping categories to subcategories (required)"
								},
								{
									"key": "businessEmail",
									"value": "business@johnelectronics.com",
									"type": "text",
									"description": "Business email address (optional)"
								},
								{
									"key": "businessPhone",
									"value": "+1234567890",
									"type": "text",
									"description": "Business phone number (optional)"
								},
								{
									"key": "country",
									"value": "United States",
									"type": "text",
									"description": "Country where business is located (required)"
								},
								{
									"key": "documentType",
									"value": "BusinessLicense",
									"type": "text",
									"description": "Type of business document (required)"
								},
								{
									"key": "documentNumber",
									"value": "BL123456",
									"type": "text",
									"description": "Business document number (optional)"
								},
								{
									"key": "businessDocument",
									"type": "file",
									"src": [],
									"description": "Business document file upload (PDF, JPG, PNG - required)"
								},
								{
									"key": "personalIdType",
									"value": "IDCard",
									"type": "text",
									"description": "Type of personal ID document (optional)"
								},
								{
									"key": "personalIdNumber",
									"value": "A123456789",
									"type": "text",
									"description": "Personal ID document number (optional)"
								},
								{
									"key": "personalId",
									"type": "file",
									"src": [],
									"description": "Personal ID document file upload (PDF, JPG, PNG - optional)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/seller-registration",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-registration"
							]
						},
						"description": "Register as a seller with complete business information and file uploads. Uses multipart/form-data to handle both text fields and file uploads in a single request. Matches Flutter frontend form structure."
					},
					"response": []
				}
			],
			"description": "User registration and login endpoints"
