{
	"info": {
		"_postman_id": "ocean-seller-verification-collection",
		"name": "Ocean - Seller Verification",
		"description": "Complete collection for Ocean app seller verification endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Public Routes",
			"item": [
				{
					"name": "Get Verification Requirements",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/seller-verification/requirements",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"requirements"
							]
						},
						"description": "Get seller verification requirements (public access)"
					},
					"response": []
				}
			],
			"description": "Public seller verification routes (no authentication required)"
		},
		{
			"name": "Protected Routes",
			"item": [
				{
					"name": "Submit Verification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"businessName\": \"My Business Name\",\n  \"businessType\": \"Individual\",\n  \"businessAddress\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zipCode\": \"10001\",\n    \"country\": \"USA\"\n  },\n  \"taxId\": \"12-3456789\",\n  \"businessLicense\": \"BL123456\",\n  \"phoneNumber\": \"+1234567890\",\n  \"website\": \"https://mybusiness.com\",\n  \"documents\": {\n    \"businessLicense\": \"https://example.com/business-license.pdf\",\n    \"taxDocument\": \"https://example.com/tax-document.pdf\",\n    \"identityDocument\": \"https://example.com/id-document.pdf\"\n  },\n  \"additionalInfo\": \"Additional business information\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/seller-verification/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"submit"
							]
						},
						"description": "Submit seller verification application"
					},
					"response": []
				},
				{
					"name": "Get Verification Status",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/seller-verification/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"status"
							]
						},
						"description": "Get current user's verification status"
					},
					"response": []
				}
			],
			"description": "Protected seller verification routes (authentication required)"
		},
		{
			"name": "Admin Routes",
			"item": [
				{
					"name": "Review Verification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"status\": \"approved\",\n  \"reviewNotes\": \"All documents verified successfully\",\n  \"adminComments\": \"Business license and tax documents are valid\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/seller-verification/admin/review",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"admin",
								"review"
							]
						},
						"description": "Admin review of seller verification (admin authentication required)"
					},
					"response": []
				},
				{
					"name": "Get Verification Stats",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/seller-verification/admin/stats",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"admin",
								"stats"
							]
						},
						"description": "Get verification statistics (admin authentication required)"
					},
					"response": []
				}
			],
			"description": "Admin seller verification routes (admin authentication required)"
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "admin_auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		}
	]
}
