								},
								{
									"key": "country",
									"value": "Nigeria",
									"type": "text"
								},
								{
									"key": "category",
									"value": "Tech",
									"type": "text"
								},
								{
									"key": "state",
									"value": "Lagos",
									"type": "text"
								},
								{
									"key": "documents",
									"value": "[{\"documentType\":\"NIN\",\"documentNumber\":\"12345678901\"},{\"documentType\":\"ElectricBill\"}]",
									"type": "text"
								},
								{
									"key": "documents",
									"type": "file",
									"src": []
