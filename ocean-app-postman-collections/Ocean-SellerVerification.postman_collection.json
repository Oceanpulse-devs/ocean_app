		{
			"name": "Admin Routes",
			"item": [
				{
					"name": "Review Verification",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"status\": \"approved\",\n  \"reviewNotes\": \"All documents verified successfully\",\n  \"adminComments\": \"Business license and tax documents are valid\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/seller-verification/admin/review",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"seller-verification",
								"admin",
								"review"
							]
						},
						"description": "Admin review of seller verification (admin authentication required)"
					},
					"response": []
				},
				{
					"name": "Get Verification Stats",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/seller-verification/admin/stats",
							"host": [
								"{{base_url}}"
