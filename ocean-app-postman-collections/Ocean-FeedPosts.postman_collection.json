					"name": "Get User Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/{{userId}}/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}",
								"posts"
							]
						},
						"description": "Get posts by specific user"
					},
					"response": []
				}
