{
	"info": {
		"_postman_id": "ocean-feed-posts-collection",
		"name": "Ocean - Feed & Posts",
		"description": "Complete collection for Ocean app feed and posts endpoints. Simplified to social media style - just content + optional images/videos. All database fields auto-filled. Separate routes for text-only posts (/api/posts/text) and posts with media (/api/posts).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Test Routes",
			"item": [
				{
					"name": "Test Feed Routes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/test",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"test"
							]
						},
						"description": "Test route to check if feed routes are working"
					},
					"response": []
				}
			],
			"description": "Test routes for feed functionality"
		},
		{
			"name": "Public Routes",
			"item": [
				{
					"name": "Get Feed",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/feed",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"feed"
							]
						},
						"description": "Get public feed (no authentication required)"
					},
					"response": []
				},
				{
					"name": "Get Single Post",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}"
							]
						},
						"description": "Get single post details"
					},
					"response": []
				},
				{
					"name": "Search Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/search?q={{searchQuery}}&category={{tech_category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "{{searchQuery}}",
									"description": "Search query"
								},
								{
									"key": "category",
									"value": "{{tech_category_id}}",
									"description": "Category filter (UUID or name)"
								}
							]
						},
						"description": "Search posts by query and category"
					},
					"response": []
				},
				{
					"name": "Get Post Comments",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}",
								"comments"
							]
						},
						"description": "Get comments for a post"
					},
					"response": []
				},
				{
					"name": "Get User Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/{{userId}}/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}",
								"posts"
							]
						},
						"description": "Get posts by specific user"
					},
					"response": []
				}
			],
			"description": "Public feed and post routes (no authentication required)"
		},
		{
			"name": "Protected Routes",
			"item": [
				{
					"name": "Get Home Feed",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/home-feed",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"home-feed"
							]
						},
						"description": "Get personalized home feed (authentication required)"
					},
					"response": []
				},
				{
					"name": "Create Post (Flexible - Text or Media)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "content",
									"value": "Looking for a vintage guitar in excellent condition! 🎸",
									"type": "text",
									"description": "Post content (required)"
								},
								{
									"key": "reach_limit",
									"value": "5",
									"type": "text",
									"description": "Number of people who can contact you (1-50, default: 5)"
								},
								{
									"key": "category_id",
									"value": "{{electronics_category_id}}",
									"type": "text",
									"description": "Optional category UUID from ProductCategory table"
								},
								{
									"key": "media",
									"type": "file",
									"src": [],
									"description": "Optional image/video files (max 10 files, 100MB each)"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts"
							]
						},
						"description": "Single flexible route for post creation. \n\n**For Text-Only Posts:** Change body mode to 'raw' and use JSON:\n```json\n{\n  \"content\": \"Your post content\",\n  \"reach_limit\": 5,\n  \"category_id\": \"{{electronics_category_id}}\"\n}\n```\n\n**For Posts with Media:** Use form-data (current setup) and add files to the 'media' field.\n\n**Features:**\n- Automatically creates buyer need\n- Validates category_id exists in database\n- Supports 1-50 reach limit (default: 5)\n- Handles up to 10 media files (100MB each)\n- All fields except 'content' are optional"
					},
					"response": []
				},
				{
					"name": "Update Post",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "content",
									"value": "Updated post content",
									"type": "text"
								},
								{
									"key": "category",
									"value": "{{fashion_category_id}}",
									"type": "text"
								},
								{
									"key": "media",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}"
							]
						},
						"description": "Update an existing post"
					},
					"response": []
				},
				{
					"name": "Delete Post",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}"
							]
						},
						"description": "Delete a post"
					},
					"response": []
				},
				{
					"name": "Toggle Like Post",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}/like",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}",
								"like"
							]
						},
						"description": "Like or unlike a post"
					},
					"response": []
				},
				{
					"name": "Toggle Save Post",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"collectionName\": \"Favorites\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}/save",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}",
								"save"
							]
						},
						"description": "Save or unsave a post (collectionName is optional, defaults to 'General')"
					},
					"response": []
				},
				{
					"name": "Get Saved Posts",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/saved-posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"saved-posts"
							]
						},
						"description": "Get user's saved posts"
					},
					"response": []
				}
			],
			"description": "Protected feed and post routes (authentication required)"
		},
		{
			"name": "Comments",
			"item": [
				{
					"name": "Create Comment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
