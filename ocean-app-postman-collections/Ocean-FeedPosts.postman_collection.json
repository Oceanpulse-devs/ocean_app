				{
					"name": "Update Comment",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Updated comment content! This is my edited comment.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/comments/{{commentId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"comments",
								"{{commentId}}"
							]
						},
						"description": "Update/edit a comment (only comment owner can edit)"
					},
					"response": []
				},
				{
					"name": "Delete Comment",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/comments/{{commentId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"comments",
								"{{commentId}}"
							]
						},
						"description": "Delete a comment (only comment owner can delete)"
					},
					"response": []
				}
			],
			"description": "Comment management"
		}
