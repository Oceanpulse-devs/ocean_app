{
	"info": {
		"_postman_id": "ocean-feed-posts-collection",
		"name": "Ocean - Feed & Posts",
		"description": "Complete collection for Ocean app feed and posts endpoints. Updated for Universal Category System - supports both UUID and name-based category lookup. Includes separate routes for text-only posts (/api/posts/text) and posts with images (/api/posts).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Test Routes",
			"item": [
				{
					"name": "Test Feed Routes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/test",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"test"
							]
						},
						"description": "Test route to check if feed routes are working"
					},
					"response": []
				}
			],
			"description": "Test routes for feed functionality"
		},
		{
			"name": "Public Routes",
			"item": [
				{
					"name": "Get Feed",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/feed",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"feed"
							]
						},
						"description": "Get public feed (no authentication required)"
					},
					"response": []
				},
				{
					"name": "Get Single Post",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}"
							]
						},
						"description": "Get single post details"
					},
					"response": []
				},
				{
					"name": "Search Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/search?q={{searchQuery}}&category={{tech_category_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "{{searchQuery}}",
									"description": "Search query"
								},
								{
									"key": "category",
									"value": "{{tech_category_id}}",
									"description": "Category filter (UUID or name)"
								}
							]
						},
						"description": "Search posts by query and category"
					},
					"response": []
				},
				{
					"name": "Get Post Comments",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/posts/{{postId}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"posts",
								"{{postId}}",
								"comments"
							]
						},
						"description": "Get comments for a post"
					},
					"response": []
				},
