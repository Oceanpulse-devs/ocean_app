							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Updated: Guitar for Camera Swap\",\n  \"description\": \"Updated description with more details\",\n  \"myItem\": {\n    \"estimatedValue\": 2800,\n    \"description\": \"Updated guitar description with additional details\"\n  },\n  \"additionalCash\": {\n    \"required\": true,\n    \"amount\": 200,\n    \"currency\": \"USD\"\n  },\n  \"expiryDate\": \"2024-03-20T23:59:59Z\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/swap-deals/{{swapDealId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"swap-deals",
								"{{swapDealId}}"
							]
						},
						"description": "Update swap deal details"
					},
					"response": []
				}
			],
			"description": "Swap deal CRUD operations"
		},
