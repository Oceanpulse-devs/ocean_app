	"item": [
		{
			"name": "Swap Deal CRUD",
			"item": [
				{
					"name": "Create Swap Deal",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Guitar for Camera Swap\",\n  \"description\": \"Looking to trade my vintage guitar for a professional camera\",\n  \"myItem\": {\n    \"name\": \"1965 Fender Stratocaster\",\n    \"description\": \"Vintage sunburst Stratocaster in excellent condition\",\n    \"category\": \"{{entertainment_category_id}}\",\n    \"condition\": \"Excellent\",\n    \"estimatedValue\": 2500,\n    \"images\": [\"https://example.com/guitar1.jpg\", \"https://example.com/guitar2.jpg\"],\n    \"tags\": [\"vintage\", \"guitar\", \"fender\", \"stratocaster\"]\n  },\n  \"wantedItem\": {\n    \"name\": \"Professional DSLR Camera\",\n    \"description\": \"Looking for Canon or Nikon DSLR with lenses\",\n    \"category\": \"{{tech_category_id}}\",\n    \"condition\": \"Good\",\n    \"estimatedValue\": 2500,\n    \"specifications\": [\"Full frame sensor\", \"Multiple lenses\", \"Low shutter count\"],\n    \"tags\": [\"camera\", \"dslr\", \"photography\", \"professional\"]\n  },\n  \"location\": {\n    \"city\": \"Los Angeles\",\n    \"state\": \"CA\",\n    \"country\": \"USA\",\n    \"meetingPreference\": \"public_place\"\n  },\n  \"swapType\": \"direct\",\n  \"urgency\": \"medium\",\n  \"expiryDate\": \"2024-03-15T23:59:59Z\",\n  \"additionalCash\": {\n    \"required\": false,\n    \"amount\": 0,\n    \"currency\": \"USD\"\n  },\n  \"contactInfo\": {\n    \"phone\": \"+1234567890\",\n    \"email\": \"trader@example.com\",\n    \"preferredContact\": \"phone\"\n  },\n  \"terms\": \"Both parties must inspect items before finalizing swap\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/swap-deals/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"swap-deals",
								"create"
							]
						},
						"description": "Create a new swap deal"
					},
					"response": []
				},
