{
	"info": {
		"_postman_id": "ocean-swap-deals-collection",
		"name": "Ocean - Swap Deals",
		"description": "Complete collection for Ocean app swap deals and item trading endpoints. File uploads are mandatory for all swap deal creation - you must upload images/videos of both items you're offering and items you want. Supports up to 20 files total (10 per item) with 100MB file size limit.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Swap Deal CRUD",
			"item": [
				{
					"name": "Create Swap Deal",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "title",
									"value": "Guitar for Camera Swap",
									"type": "text"
								},
								{
									"key": "description",
									"value": "Looking to trade my vintage guitar for a professional camera",
									"type": "text"
								},
								{
									"key": "myItem",
									"value": "{\"name\": \"1965 Fender Stratocaster\", \"description\": \"Vintage sunburst Stratocaster in excellent condition\", \"category\": \"{{entertainment_category_id}}\", \"condition\": \"like_new\", \"estimatedValue\": 2500}",
									"type": "text"
								},
								{
									"key": "wantedItem",
									"value": "{\"name\": \"Professional DSLR Camera\", \"description\": \"Looking for Canon or Nikon DSLR with lenses\", \"category\": \"{{tech_category_id}}\", \"condition\": \"good\", \"estimatedValue\": 2500}",
									"type": "text"
								},
								{
									"key": "meeting_location",
									"value": "Los Angeles, CA, USA",
									"type": "text"
								},
								{
									"key": "meeting_date",
									"value": "2024-03-15T15:00:00Z",
									"type": "text"
								},
								{
									"key": "swap_terms",
									"value": "Both parties must inspect items before finalizing swap",
									"type": "text"
								},
								{
									"key": "initiator_message",
									"value": "Hi! I'm interested in swapping our items. Let me know if you're interested!",
									"type": "text"
								},
								{
									"key": "myItem_image1",
									"description": "Upload photo of your guitar (front view)",
									"type": "file"
								},
								{
									"key": "myItem_image2",
									"description": "Upload photo of your guitar (back view)",
									"type": "file"
								},
								{
									"key": "myItem_image3",
									"description": "Upload photo of your guitar (close-up of condition)",
									"type": "file"
								},
								{
									"key": "wantedItem_image1",
									"description": "Upload screenshot/photo of camera you want (front view)",
									"type": "file"
								},
								{
									"key": "wantedItem_image2",
									"description": "Upload screenshot/photo of camera you want (back view)",
									"type": "file"
								},
								{
									"key": "arModel",
									"type": "file",
									"src": [],
									"description": "Optional: AR model file (GLB/GLTF format, max 100MB) for 3D viewing of swap deal items"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/swap-deals/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"swap-deals",
								"create"
							]
						},
						"description": "Create a new swap deal with mandatory file uploads (images/videos). You must upload at least one image/video for each item (myItem and wantedItem). Supports up to 20 files total (10 per item). File size limit: 100MB per file. Accepted formats: Images (JPG, PNG, GIF, etc.) and Videos (MP4, MOV, AVI, etc.)"
					},
					"response": []
				},
				{
					"name": "Get All Swap Deals",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/swap-deals/all?page=1&limit=20&category={{tech_category_id}}&status=active",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"swap-deals",
								"all"
							],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "20",
									"description": "Items per page"
								},
								{
									"key": "category",
									"value": "{{tech_category_id}}",
									"description": "Filter by category (UUID or name)"
								},
								{
									"key": "status",
									"value": "active",
									"description": "Filter by status (active, pending, completed, cancelled)"
								}
							]
						},
						"description": "Get all swap deals with filtering"
					},
					"response": []
				},
				{
					"name": "Get Swap Deal by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/swap-deals/{{swapDealId}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"swap-deals",
								"{{swapDealId}}"
							]
						},
						"description": "Get specific swap deal details"
					},
					"response": []
				},
				{
					"name": "Update Swap Deal",
