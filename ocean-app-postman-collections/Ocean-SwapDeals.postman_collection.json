{
	"info": {
		"_postman_id": "ocean-swap-deals-collection",
		"name": "Ocean - Swap Deals",
		"description": "Complete collection for Ocean app swap deals and item trading endpoints. Updated for Universal Category System - supports both UUID and name-based category lookup.",
