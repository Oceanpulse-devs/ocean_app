# Ocean Message Server Environment Configuration

# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Shared with main server)
DB_HOST=your_mysql_host
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DB_PORT=3306

# JWT Secret (Must match JWT_SECRET in main server)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Redis Configuration (Optional / Shared with main server)
REDIS_URL=your_redis_url

# CORS Configuration
CLIENT_URL=https://your-frontend-domain.com

# Main Server Communication
MAIN_SERVER_URL=https://your-main-server-domain.com
INTERNAL_API_TOKEN=your_internal_api_token_here

# Storage Configuration (Shared with main server)
STORAGE_PROVIDER=cloudinary # 'cloudinary' or 'r2'

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dh753xlhq
CLOUDINARY_API_KEY=776633772583837
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 Configuration (Optional / if STORAGE_PROVIDER=r2)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=bluewhale-media
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
