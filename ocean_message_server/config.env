# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (Same as main server)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=j@123098
DB_NAME=ocean_app_db
DB_PORT=3306

# JWT Configuration (Same secret as main server)
JWT_SECRET=development
JWT_EXPIRES_IN=7d

# Redis Configuration (Same as main server)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Main Server Configuration (for cross-server communication)
MAIN_SERVER_URL=http://localhost:5000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=25000
WS_HEARTBEAT_TIMEOUT=5000

# Message Configuration
MAX_MESSAGE_LENGTH=1000
MESSAGE_RETENTION_DAYS=365

# Database Sync Configuration (Set to 'true' to recreate tables)
# Note: Messaging server no longer creates tables - main server handles this
SYNC_DATABASE=false 